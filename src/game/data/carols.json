{"all":[{"title":"Авсень-коляда","kind":"kolyadka","lines":["Авсень, авсень, ты ходил по всем,","По заулочкам, по проулочкам,","Кому песни — кому девки,","А кому-то и полушки-пирога.","Ты, хозяюшка, подай,","Не жалей своих благ,","Зима-то длинна,","А ночь-то темна!"]},{"title":"Коляда-коляда","kind":"kolyadka","lines":["Коляда, коляда, ты подай пирога,","А кто не подаст — тому холод в дом,","А кто подаст — тому всю жизнь богатство,","Дай, Господь, хозяину здоровья да тепла,","Дом — полную чашу, двор — полон скота,","А нам — уходить до утра."]},{"title":"Уж ты, зимушка","kind":"song","lines":["Уж ты, зимушка-зима,","Ты пришла с ногами холодными,","Замела пути-дороги,","Заморозила быка за рога.","Мы по горенкам сидим,","На тебя, зима, глядим,","Ты нас, старая, не трожь —","Мы и так не так уж живы."]},{"title":"Как пошли наши ребята","kind":"kolyadka","lines":["Как пошли наши ребята","Колядовать-гулять,","Снег по пояс, ночь до края,","А мороз — до костей.","Хозяин, хозяюшка,","Вы нам вынесите по кусочку,","А не вынесете — мы в окошко","Снегом, снегом, снегом!"]},{"title":"Ой, мороз, мороз","kind":"song","lines":["Ой, мороз, мороз,","Не морозь меня,","Не морозь меня,","Моего коня.","У меня-то конь","Всю дорогу знал,","А теперь стоит —","Копыт не чует."]},{"title":"Святый вечер","kind":"kolyadka","lines":["Святый вечер, добрый вечер,","Добрым людям на здравие,","А худым — на размышление.","Хозяин, вставай,","Дверь отпирай,","Коляду-то встречай,","Тепла-то набирай."]},{"title":"Воск-вощина","kind":"gadanie","lines":["Воск-вощина, вылей-ка судьбу,","Что на рождество — то и на всю зиму,","Куда ляжет полоса —","Туда и жизнь понесётся."]},{"title":"Зеркало и свеча","kind":"gadanie","lines":["Свет — от свечи, тьма — от угла,","Суженый-ряженый, приди ко мне ужинать,","Приди по снегу, по звезде,","По скрипу половицы."]},{"title":"Петух и зерно","kind":"gadanie","lines":["Клюнет зерно — к сытости,","Клюнет уголь — к стуже,","Клюнет кольцо — к весточке,","А не клюнет — к долгой зиме."]},{"title":"Как на святки","kind":"strashilka","lines":["Как на святки, по ночам,","Ходит-бродит старый шаман,","Не с бубном — с метлой,","Замечает след за тобой.","Ты в избу — он за тобой,","Ты в печь — он на трубу,","Ты спать — он стеречь."]},{"title":"Святочный волк","kind":"strashilka","lines":["В святки волк молчит,","А как промолчит —","Значит, ходит близко,","Значит, слушает.","Кто у печки сидит —","Того не тронет.","А кто в лес пошёл —","Тому — колядка последняя."]}]}